# Backend Environment Variables
PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agriindia?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/agriindia?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production

# Frontend URLs for CORS
FRONTEND_URL=https://agri-indiaa.vercel.app
ADVISOR_PANEL_URL=https://agri-india-advisor.vercel.app
ADMIN_PANEL_URL=https://agri-india-admin.vercel.app
ALLOWED_ORIGINS=https://agri-indiaa.vercel.app

# Cloudinary Config
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret_key

# Admin Default Credentials
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=your_admin_password
